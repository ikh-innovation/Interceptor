serverAddr = "__SERVER__"
serverPort = 7000

auth.method = "token"
auth.token  = "__TOKEN__"

log.to      = "/var/log/frpc.log"
log.level   = "info"
log.maxDays = 7

transport.heartbeatInterval = 10
transport.heartbeatTimeout  = 30

[[proxies]]
name       = "__NAME__"
type       = "http"
localIP    = "127.0.0.1"
localPort  = __LOCAL_PORT__
subdomain  = "__NAME__"
