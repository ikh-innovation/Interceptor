provider "google" {
  project = var.project_id
  region  = var.region
  zone    = var.zone
}

# --- APIs -------------------------------------------------------------------

resource "google_project_service" "compute" {
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "firestore" {
  service            = "firestore.googleapis.com"
  disable_on_destroy = false
}

# --- Static external IP -----------------------------------------------------

resource "google_compute_address" "drones" {
  name         = "drones-ip"
  region       = var.region
  address_type = "EXTERNAL"
  depends_on   = [google_project_service.compute]
}

# --- Computed domain (via sslip.io) -----------------------------------------
# sslip.io is a free DNS service: any.1-2-3-4.sslip.io resolves to 1.2.3.4.
# Lets Encrypt still works via HTTP-01, so we get real HTTPS with zero DNS setup.

locals {
  domain = "${replace(google_compute_address.drones.address, ".", "-")}.sslip.io"
}

# --- Firewall ---------------------------------------------------------------

resource "google_compute_firewall" "ssh" {
  name    = "drones-allow-ssh"
  network = "default"
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
  source_ranges = ["0.0.0.0/0"]
  target_tags   = ["drones-relay"]
}

resource "google_compute_firewall" "web" {
  name    = "drones-allow-web"
  network = "default"
  allow {
    protocol = "tcp"
    ports    = ["80", "443"]
  }
  source_ranges = ["0.0.0.0/0"]
  target_tags   = ["drones-relay"]
}

resource "google_compute_firewall" "frp" {
  name    = "drones-allow-frp"
  network = "default"
  allow {
    protocol = "tcp"
    ports    = ["7000"]
  }
  source_ranges = ["0.0.0.0/0"]
  target_tags   = ["drones-relay"]
}

# --- VM ---------------------------------------------------------------------

resource "google_compute_instance" "relay" {
  name         = "drones-relay"
  machine_type = var.machine_type
  tags         = ["drones-relay"]

  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
      size  = 20
      type  = "pd-balanced"
    }
  }

  network_interface {
    network = "default"
    access_config {
      nat_ip = google_compute_address.drones.address
    }
  }

  metadata = {
    enable-oslogin = "TRUE"
  }

  metadata_startup_script = nonsensitive(templatefile("${path.module}/startup.sh.tpl", {
    domain               = local.domain
    letsencrypt_email    = var.letsencrypt_email
    basic_auth_user      = var.basic_auth_user
    basic_auth_bcrypt    = replace(var.basic_auth_bcrypt, "$", "\\$")
    frp_token            = var.frp_token
    frp_admin_user       = var.frp_admin_user
    frp_admin_password   = var.frp_admin_password
    frp_admin_basic_b64  = base64encode("${var.frp_admin_user}:${var.frp_admin_password}")
    dashboard_html_b64   = base64encode(file("${path.module}/../vm/dashboard.html"))
  }))

  shielded_instance_config {
    enable_secure_boot = true
  }

  depends_on = [google_project_service.compute]
}

# --- Jetson-side config file (committed to git) -----------------------------
# Written locally by `terraform apply` so a freshly cloned Jetson just needs
# `git pull` + `install-frpc.sh --name X` + dashboard password. No token copying.

resource "local_file" "relay_conf" {
  filename        = "${path.module}/../jetson/relay.conf"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by `terraform apply` — safe to commit.
    RELAY_SERVER=${local.domain}
    RELAY_USER=${var.basic_auth_user}
  EOT
}
