[Unit]
Description=WASP drone tracker (auto-start at Jetson power-up, intercept law)


StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/iknowhow/Documents/Interceptor-1/src




ExecStartPre=/bin/sleep 15

ExecStart=/home/iknowhow/Documents/Interceptor-1/src/start-wasp.sh

StandardOutput=append:/home/iknowhow/wasp-logs/wasp-tracker.log
StandardError=append:/home/iknowhow/wasp-logs/wasp-tracker.log

Restart=on-failure
RestartSec=10

SuccessExitStatus=130
TimeoutStopSec=25
KillSignal=SIGINT

[Install]
WantedBy=default.target
