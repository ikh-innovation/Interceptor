[Unit]
Description=WASP


StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Documents/wasp/src




ExecStartPre=/bin/sleep 15

ExecStart=%h/Documents/wasp/src/start-wasp.sh

StandardOutput=append:%h/wasp-logs/wasp-tracker.log
StandardError=append:%h/wasp-logs/wasp-tracker.log

Restart=on-failure
RestartSec=10

SuccessExitStatus=130
TimeoutStopSec=25
KillSignal=SIGINT

[Install]
WantedBy=default.target
