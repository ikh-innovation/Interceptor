[Unit]
Description=WASP head-tracker pipeline (FC identification + MAVLink router + tracker)
Documentation=file:///home/iknowhow/face_tracker/README.md
# systemd USER service: starts automatically when iknowhow's graphical session
# comes up at boot (autologin). Install at ~/.config/systemd/user/.
# cv2 HUD needs the X display, so bind to the graphical session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/iknowhow/Documents/Interceptor-1/src/development/modules/object_tracking

# --- X display of the autologin session ---
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority

# FC serial is auto-detected by run_pipeline.py — the board's by-id descriptor
# AND its ACM number both change across reboots, so do NOT hardcode a path here.
# Set FC_DEV only to override.

# --- control transport ---
# run_pipeline.py identifies the firmware on the port before anything claims it,
# then wires the transport itself:
#   ArduPilot  -> MAVLink router; tracker on udpin:127.0.0.1:14551 driving
#                 RC_CHANNELS_OVERRIDE in the pilot's ACRO mode
#   Betaflight -> no router; tracker owns the serial port, MSP_SET_RAW_RC
# Nothing about the transmitter is hardcoded: the channel map, the calibration
# and the ACRO full-stick rates are all read off the FC at connect. The tracker
# also adopts the FC's SYSID_MYGCS, without which ArduPilot silently discards
# every override.
#
# Sticks are driven ONLY while the FC is armed and a target is locked; roll,
# throttle and arming always stay with the pilot, and every channel is released
# the instant the target is lost or the tracker exits.
Environment=CONTROL_AXES=yaw,pitch

# --- control tuning ---
# TRUE lens FOV. A wrong value only rescales the loop gain, so if the drone
# chases too hard or too softly, prefer tuning KP_* over guessing the optics.
Environment=CAM_HFOV_DEG=62.2
Environment=CAM_VFOV_DEG=48.8
# rad/s of body rate per rad of angular error. Raise to centre faster.
Environment=KP_YAW=2.0
Environment=KP_PITCH=2.0
# Authority ceiling: the tracker never deflects a stick further than this.
Environment=STICK_LIMIT=0.55
# Centre deadband as a fraction of the half-frame; stops twitching on a target
# that is already centred.
Environment=DEADBAND_FRAC=0.03
# Set these to 1 if an axis drives the WRONG way on the gimbal. The symptom is
# unmistakable: the drone turns AWAY from the head and runs to the gimbal stop.
# Environment=YAW_REVERSED=1
# Environment=PITCH_REVERSED=1

# --- optional toggles (uncomment as needed) ---
# Environment=TRACKER_HEADLESS=1     # no cv2 HUD window
# Environment=CAM_DEV=/dev/video0
# Environment=MAV_CONN=none          # offline: compute + print, never transmit

# Give udev + the X session a moment to settle.
ExecStartPre=/bin/sleep 10

# Run under yolo-env python (the launcher imports pymavlink at preflight).
# --no-mp: router + tracker only, no Mission Planner.
ExecStart=/home/iknowhow/yolo-env/bin/python /home/iknowhow/Documents/Interceptor-1/src/development/modules/object_tracking/run_pipeline.py --no-mp

Restart=on-failure
RestartSec=5
TimeoutStopSec=20
# KillMode defaults to control-group: stopping the service also kills the
# router and tracker it spawned (they share the cgroup). The tracker releases
# every overridden channel back to the pilot on the way out.

[Install]
WantedBy=graphical-session.target
