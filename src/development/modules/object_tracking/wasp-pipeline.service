[Unit]
Description=WASP face-tracker pipeline (MAVProxy router + tracker, no Mission Planner)
Documentation=file:///home/iknowhow/face_tracker/README.md
# systemd USER service: starts automatically when iknowhow's graphical session
# comes up at boot (autologin). Install at ~/.config/systemd/user/.
# cv2 HUD needs the X display, so bind to the graphical session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/iknowhow/Documents/Interceptor-1/src/development/modules/object_tracking

# --- X display of the autologin session ---
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority

# FC serial is auto-detected by run_pipeline.py (ArduPilot vendor prefix on the
# -if00 MAVLink interface) — the board's by-id serial AND ACM number both change
# across reboots, so do NOT hardcode a path here. Set FC_DEV only to override.

# --- control transport ---
# RC override: drives the drone via RC_CHANNELS_OVERRIDE in the pilot's ACRO mode.
# Works on a stationary gimbal with NO GPS. Only steers when ARMED + a target is
# locked; releases the sticks back to the pilot otherwise and on exit. The RC
# channel map + calibration are read from the FC — nothing is hardcoded.
Environment=CONTROL_MODE=rc
Environment=CONTROL_AXES=yaw,pitch
Environment=RC_GAIN=0.5
# Set these if an axis drives the WRONG way (checked on the gimbal):
# Environment=RC_YAW_REVERSED=1
# Environment=RC_PITCH_REVERSED=1

# --- optional toggles (uncomment as needed) ---
# Environment=TRACKER_HEADLESS=1     # no cv2 HUD window
# Environment=CAM_DEV=/dev/video0

# Give udev + the X session a moment to settle.
ExecStartPre=/bin/sleep 10

# Run under yolo-env python (the launcher imports pymavlink at preflight).
# --no-mp: router + tracker only, no Mission Planner.
ExecStart=/home/iknowhow/yolo-env/bin/python /home/iknowhow/Documents/Interceptor-1/src/development/modules/object_tracking/run_pipeline.py --no-mp

Restart=on-failure
RestartSec=5
TimeoutStopSec=20
# KillMode defaults to control-group: stopping the service also kills the
# router and tracker it spawned (they share the cgroup).

[Install]
WantedBy=graphical-session.target
